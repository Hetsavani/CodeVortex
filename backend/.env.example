NODE_ENV=development
PORT=5000
# Example: mongodb://mongo:27017/codevortex_dev (docker-compose)
# Or Atlas: mongodb+srv://user:pass@cluster0.qcip5sp.mongodb.net/CodeVortex
MONGO_URI=mongodb+srv://user:pass@cluster0.qcip5sp.mongodb.net/CodeVortex
REDIS_URL=redis://localhost:6379
JWT_ACCESS_SECRET= # node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_REFRESH_SECRET= # different 256-bit hex
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY=7d
GEMINI_API_KEY=
FIREBASE_SERVICE_ACCOUNT= # base64 JSON
ALLOWED_ORIGIN=http://localhost:5173
SENTRY_DSN=
